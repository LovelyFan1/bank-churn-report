# Native Python configuration: copy to backend/.env.
# Docker Compose interpolation uses the repository-root .env instead.
# Preserve existing environment files and keep real credentials out of Git.

# App
APP_NAME="Bank Customer Churn Analysis System"
VERSION="1.0.0"
DEBUG=false

# Local SQLite; this is different from the Docker backend_data volume.
DATABASE_URL=sqlite:///./churn_analysis.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Data generation
NUM_CUSTOMERS=10000
CHURN_RATE=0.2037

# ── 数据来源 ──────────────────────────────────────────────
# generator = generate synthetic customers when the database is empty
# csv = read a separately provided simulated CSV from DATA_CSV_PATH
#
# Existing non-empty tables are not replaced when DATA_SOURCE changes.
# Switch data sources using a separate database or an explicit migration.
DATA_SOURCE=generator
# DATA_SOURCE=csv
DATA_CSV_PATH=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ML
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5
DATA_CHUNK_SIZE=50000

# Authentication and server-side sessions
AUTH_ENABLED=true
AUTH_SECRET_KEY=
AUTH_REQUIRE_TOTP=true
AUTH_TOKEN_TTL_MINUTES=120
AUTH_IDLE_MINUTES=30
AUTH_DEMO_SHOW_TOTP=false
# Change the initial demo password before first seeding if needed.
# AUTH_DEMO_PASSWORD=choose-your-own-local-demo-password

# Optional tool-calling agent; keys are used by the backend only.
AGENT_ENABLED=false
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_MODEL=deepseek-chat
