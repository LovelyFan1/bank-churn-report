# Bank Churn Analysis - Environment Configuration
# Copy this file to .env and adjust for your environment

# App
APP_NAME="Bank Customer Churn Analysis System"
VERSION="1.0.0"
DEBUG=true

# Database (SQLite for dev; switch to PostgreSQL for 10M+ scale)
DATABASE_URL=sqlite:///./churn_analysis.db
# DATABASE_URL=postgresql://user:password@localhost:5432/churn_analysis

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Data generation
NUM_CUSTOMERS=10000
CHURN_RATE=0.2037

# ── 数据来源 ──────────────────────────────────────────────
# generator = 启动时现算合成数据（默认，不依赖外部文件，适合离线兜底）
# csv       = 读 DATA_CSV_PATH 指向的 CSV（标定数据，10 万客户）
#
# ⚠ 切换数据源前必须清空 customers 表 —— 两套数据的 customer_id
#   完全重叠但指向不同的人，叠加会出现同编号两套记录，且不会报错。
DATA_SOURCE=generator
# DATA_SOURCE=csv
DATA_CSV_PATH=/data-source/customers_simulated.csv

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ML
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5
DATA_CHUNK_SIZE=50000
