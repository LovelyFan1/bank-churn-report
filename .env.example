# Docker Compose configuration: copy to the repository root as .env.
# Preserve an existing .env. Do not commit real credentials.

# Fresh clones can start without the external simulated CSV.
# To use ../模拟仿真客户数据/customers_simulated.csv, set csv explicitly.
DATA_SOURCE=generator
DEBUG=false
WEB_WORKERS=4

# Optional task agent. Requires a tool-calling compatible model.
AGENT_ENABLED=false
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_MODEL=deepseek-chat

# Empty: generate and persist a signing key at first startup.
# Set your own random value for a managed deployment and back it up privately.
AUTH_SECRET_KEY=
# Only for isolated local development; release override always disables this.
AUTH_DEMO_SHOW_TOTP=false
